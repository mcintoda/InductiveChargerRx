# Release fragment 1: SIGNED IMAGES (burns no eFuses: safe on any board)
#   idf.py -B build-release -D SDKCONFIG=build-release/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.release" build
# The bootloader and the running app only accept RSA-3072-signed images; a firmware upload on the settings page
# is checked against the key of the image already running. Key: keys/brim_signing_key.pem (gitignored), made with
#   espsecure.py generate_signing_key --version 2 --scheme rsa3072 keys/brim_signing_key.pem
# Keep the key in a password manager / offline. Lose it and units can never be updated again.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_BOOT_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/brim_signing_key.pem"
# release builds also refuse an unprotected setup network (main/factory.h)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
